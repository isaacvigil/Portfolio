---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import { Image } from 'astro:assets';
import ProjectHero from '../../components/ProjectHero.astro';
import ComponentsImage from '../../components/ComponentsImage.astro';
import ProjectFooter from '../../components/ProjectFooter.astro';
import Icon from '../../components/Icon.astro';

import coverImg from '../../assets/Ford-CCP/cover.jpg';
import vanConversion from '../../assets/Ford-CCP/van-conversion.jpg';
import personaEmily from '../../assets/Ford-CCP/Persona-Emily-1-scaled.jpg';
import personaTony from '../../assets/Ford-CCP/Persona-Tony-scaled.jpg';
import personaNick from '../../assets/Ford-CCP/Persona-Nick-1-scaled.jpg';
import keyFindings from '../../assets/Ford-CCP/Key-Findings.png';
import customerFlow from '../../assets/Ford-CCP/Ford-CCP-customer-flow-1.png';
import userTestingImg from '../../assets/Ford-CCP/user-testing-nick-stubbington-scaled.jpg';
import utInsights from '../../assets/Ford-CCP/UT-insights.png';
import componentsImg from '../../assets/Ford-CCP/Ford-CCP-Components.png';
import signIn from '../../assets/Ford-CCP/Sign-In.jpg';
import dashboard from '../../assets/Ford-CCP/1.1.01-Customer-Dashboard.jpg';
import newRequestType from '../../assets/Ford-CCP/1.1.02-Customer-New-Request-Conversion-type-scaled.jpg';
import vehicleDetails from '../../assets/Ford-CCP/1.1.03-Customer-New-Request-Vehicle-details.jpg';
import conversionDetails from '../../assets/Ford-CCP/1.1.06-Customer-New-Request-Conversion-Details.jpg';
import selectDealer from '../../assets/Ford-CCP/1.1.07b-Customer-New-Request-Select-dealer.jpg';
import reviewSubmit from '../../assets/Ford-CCP/1.1.08-Customer-New-Request-Review-and-submit-scaled.jpg';
---

<Layout>
  <main>

    <Nav backHref="/" />

    <ProjectHero
      title="Ford Conversion Platform"
      meta={[
        { label: 'Role', value: 'UX Lead' },
        { label: 'Company', value: 'Ford' },
        { label: 'Year', value: '2021' },
        { label: 'Type', value: 'Web Platform' },
      ]}
      coverImg={coverImg}
      coverAlt="Ford commercial vehicles"
    />

    <!-- Opportunity -->
    <section class="mb-20 section-block" id="opportunity">
      <div class="max-w-5xl mx-auto px-8">
        <h2 class="text-section-heading mb-6">Opportunity</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <p class="text-lg leading-relaxed opacity-80">
            Commercial vehicles represent Ford's primary European revenue source. Many require specialized conversions: refrigerated units, racking, lifting equipment.
          </p>
          <p class="text-lg leading-relaxed opacity-80">
            The conversions specifications were captured by Ford dealers through phone and email, then shared with the converters, making it difficult for everyone to keep track.
          </p>
        </div>
      </div>
    </section>

    <!-- Goals -->
    <section class="mb-20 section-block">
      <div class="max-w-5xl mx-auto px-8">
        <h2 class="text-section-heading mb-6">Goals</h2>
        <p class="text-lg leading-relaxed opacity-80 max-w-2xl">
          Create a commercial vehicle platform for Ford to increase sales of commercial vehicles and simplify the process to convert a vehicle.
        </p>
      </div>
    </section>

    <!-- My Role -->
    <section class="mb-20 section-block">
      <div class="max-w-5xl mx-auto px-8">
        <h2 class="text-section-heading mb-6">My role as UX Lead</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <ul class="list-disc list-outside pl-5 text-lg leading-relaxed opacity-80">
            <li>Experience strategy and design</li>
            <li>Balanced business goals against user needs</li>
            <li>Research: workshops, interviews, usability testing</li>
            <li>Quality standards across deliverables</li>
          </ul>
          <div>
            <p class="text-lg leading-relaxed opacity-80 mb-4">Team composition:</p>
            <ul class="list-disc list-outside pl-5 text-lg leading-relaxed opacity-80">
              <li>5 Product Designers (led by Isaac Vigil)</li>
              <li>Ford UK stakeholders</li>
              <li>Front-end, back-end, and QA teams</li>
            </ul>
          </div>
        </div>
      </div>
      <div class="max-w-5xl mx-auto px-8 mt-8">
        <Image src={vanConversion} alt="Ford van conversion" class="w-full rounded-2xl object-cover" />
        <p class="text-sm opacity-50 mt-2 text-center">One of the van conversions offered: racking system</p>
      </div>
    </section>

    <!-- User Types & Personas -->
    <section class="mb-20 section-block">
      <div class="max-w-5xl mx-auto px-8">
        <h2 class="text-section-heading mb-6">User Types & Personas</h2>
        <p class="text-lg leading-relaxed opacity-80 mb-8">
          Three distinct user types guided the design: customers requiring vehicle conversion, dealers managing orders, and converters adapting vehicles.
        </p>
      </div>
      <div class="max-w-7xl mx-auto px-8">
        <div class="relative">
          <Image src={personaEmily} alt="Persona Emily" id="persona-img-0" class="w-full rounded-[24px] object-cover" />
          <Image src={personaTony} alt="Persona Tony" id="persona-img-1" class="absolute inset-0 w-full rounded-[24px] object-cover opacity-0" />
          <Image src={personaNick} alt="Persona Nick" id="persona-img-2" class="absolute inset-0 w-full rounded-[24px] object-cover opacity-0" />

          <!-- Prev arrow -->
          <button id="persona-prev" aria-label="Previous persona" class="absolute left-4 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full flex items-center justify-center bg-[var(--bg)] border border-[var(--border)] hover:opacity-70 transition-opacity shadow-sm">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M10 12L6 8l4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>

          <!-- Next arrow -->
          <button id="persona-next" aria-label="Next persona" class="absolute right-4 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full flex items-center justify-center bg-[var(--bg)] border border-[var(--border)] hover:opacity-70 transition-opacity shadow-sm">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M6 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>

          <!-- Pause/Play button -->
          <button id="persona-pause" aria-label="Pause autoplay" class="absolute right-4 bottom-4 w-10 h-10 rounded-full flex items-center justify-center bg-[var(--bg)] border border-[var(--border)] hover:opacity-70 transition-opacity shadow-sm">
            <!-- Pause icon -->
            <svg id="persona-pause-icon" width="16" height="16" viewBox="0 0 16 16" fill="none"><rect x="4" y="3" width="3" height="10" rx="1" fill="currentColor"/><rect x="9" y="3" width="3" height="10" rx="1" fill="currentColor"/></svg>
            <!-- Play icon (hidden by default) -->
            <svg id="persona-play-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" class="hidden"><path d="M5 3.5l8 4.5-8 4.5V3.5z" fill="currentColor"/></svg>
          </button>
        </div>
        <p class="text-sm opacity-50 mt-2 text-center" id="persona-caption">Emily ⋅ Customer</p>
      </div>
    </section>

    <!-- Research -->
    <section class="mb-20 section-block">
      <div class="max-w-5xl mx-auto px-8">
        <h2 class="text-section-heading mb-6">Research</h2>
        <div class="flex flex-col gap-12">
          <div>
            <p class="text-xl font-semibold opacity-80 mb-2">Workshops</p>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-6">
              <p class="text-lg leading-relaxed opacity-80">
                I led the team in conducting a series of workshops with the stakeholders to identify the needs, blockers, and opportunities.
              </p>
              <p class="text-lg leading-relaxed opacity-80">
                From those workshops, we defined the necessary features for each user type, the steps from request creation until delivery, and the overall process.
              </p>
            </div>
            <Image src={keyFindings} alt="Notes from workshops" class="w-full object-cover" />
            <p class="text-sm opacity-50 mt-2 text-center">Notes from workshops</p>
          </div>
          <div>
            <p class="text-xl font-semibold opacity-80 mb-2">User flows</p>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-6">
              <p class="text-lg leading-relaxed opacity-80">
                From the workshops we got the necessary information to create the different user flows when using the platform.
              </p>
            </div>
          </div>
        </div>
      </div>
      <div class="max-w-7xl mx-auto px-8 mb-12">
        <Image src={customerFlow} alt="One of the user flows created" class="w-full object-cover" />
      </div>
      <div class="max-w-5xl mx-auto px-8">
        <div class="flex flex-col gap-12">
          <div>
            <p class="text-xl font-semibold opacity-80 mb-2">Interviews & Usability Testing</p>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-6">
              <p class="text-lg leading-relaxed opacity-80">
                A series of remote user interviews and usability tests were conducted, engaging customers, dealers, and converters.
              </p>
              <p class="text-lg leading-relaxed opacity-80">
                These sessions provided valuable insights into user behaviors, preferences, and pain points, informing critical design decisions and aligning the final product with the expectations of its diverse audience.
              </p>
            </div>
            <Image src={userTestingImg} alt="Screen capture of one of the recorded sessions" class="w-full rounded-2xl object-cover mb-4" />
            <Image src={utInsights} alt="Comments from the interviews" class="w-full rounded-2xl object-cover" />
            <p class="text-sm opacity-50 mt-2 text-center">Comments from the interviews</p>
          </div>
        </div>
      </div>
    </section>


    <!-- Components Library -->
    <section class="mb-20 section-block">
      <div class="max-w-5xl mx-auto px-8">
        <h2 class="text-section-heading mb-6">Components library</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <p class="text-lg leading-relaxed opacity-80">
            Creating those components early on ensured consistency across the project, reducing friction in handoffs between the design and engineering teams.
          </p>
          <p class="text-lg leading-relaxed opacity-80">
            The library covered all interactive patterns across customer, dealer, and converter flows.
          </p>
        </div>
      </div>
      <div class="mt-8">
        <ComponentsImage src={componentsImg} alt="Ford CCP component library" />
      </div>
    </section>

    <!-- High Fidelity Designs -->
    <section class="mb-20 section-block">
      <div class="max-w-5xl mx-auto px-8">
        <h2 class="text-section-heading mb-6">High fidelity designs</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
          <p class="text-lg leading-relaxed opacity-80">
            The platform was designed for desktop and tablet initially, with mobile planned for a future phase. The customer flow covers the full conversion request journey.
          </p>
          <p class="text-lg leading-relaxed opacity-80">
            Deliverables included the sign-in screen, customer dashboard, and a 5-step new conversion request flow.
          </p>
        </div>
      </div>
      <div class="max-w-7xl mx-auto px-8">
        <div class="grid grid-cols-1 gap-4 mt-8">
          <div>
            <Image src={signIn} alt="Sign in screen" class="w-full rounded-2xl object-cover" />
            <p class="text-sm opacity-50 mt-2 text-center">Sign in</p>
          </div>
          <div>
            <Image src={dashboard} alt="Customer dashboard" class="w-full rounded-2xl object-cover" />
            <p class="text-sm opacity-50 mt-2 text-center">Customer dashboard</p>
          </div>
          <div>
            <Image src={newRequestType} alt="New request ⋅ conversion type" class="w-full rounded-2xl object-cover" />
            <p class="text-sm opacity-50 mt-2 text-center">New request ⋅ conversion type</p>
          </div>
          <div>
            <Image src={vehicleDetails} alt="New request ⋅ vehicle details" class="w-full rounded-2xl object-cover" />
            <p class="text-sm opacity-50 mt-2 text-center">New request ⋅ vehicle details</p>
          </div>
          <div>
            <Image src={conversionDetails} alt="New request ⋅ conversion details" class="w-full rounded-2xl object-cover" />
            <p class="text-sm opacity-50 mt-2 text-center">New request ⋅ conversion details</p>
          </div>
          <div>
            <Image src={selectDealer} alt="New request ⋅ select dealer" class="w-full rounded-2xl object-cover" />
            <p class="text-sm opacity-50 mt-2 text-center">New request ⋅ select dealer</p>
          </div>
          <div>
            <Image src={reviewSubmit} alt="New request ⋅ review & submit" class="w-full rounded-2xl object-cover" />
            <p class="text-sm opacity-50 mt-2 text-center">New request ⋅ review & submit</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Final Thoughts -->
    <section class="mb-20 section-block">
      <div class="max-w-5xl mx-auto px-8">
        <h2 class="text-section-heading mb-6">Final Thoughts</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <p class="text-lg leading-relaxed opacity-80">
            Leading the design for the conversion platform was a very complex challenge;  many moving parts, three distinct user types with very different needs, and a tight timeline to hold it all together.
          </p>
          <p class="text-lg leading-relaxed opacity-80">
            What made it worthwhile was watching the team rise to it. Seeing the product come together, and seeing people do their best work under real constraints, was genuinely rewarding.
          </p>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="mb-16 section-block">
      <div class="max-w-7xl mx-auto px-8 mb-12">
        <h3 class="text-xl text-center">Thanks for reading, want to collaborate together? Contact me <a href="mailto:hi@luisisaac.com" class="underline">here</a></h3>
      </div>
    </section>

    <ProjectFooter nextHref="/project/fab-dubai-first" nextTitle="First Abu Dhabi Bank ⋅ Dubai First">
      <Icon name="CreditCard" size={20} />
    </ProjectFooter>

  </main>
</Layout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const titleEl = document.getElementById('hero-title') as HTMLElement;
  const text = titleEl.textContent?.trim() ?? '';
  titleEl.style.opacity = '1';
  titleEl.innerHTML = text
    .split(' ')
    .map(word =>
      `<span class="inline-block whitespace-nowrap">${word.split('').map(ch => `<span style="opacity:0;color:var(--muted)">${ch}</span>`).join('')}</span>`)
    .join(' ');

  gsap.set('.hero-meta', { x: -20, opacity: 0 });

  const spans = titleEl.querySelectorAll('span');
  const tl = gsap.timeline({
    onComplete: () => {
      document.querySelectorAll<HTMLElement>('.hero-meta').forEach(el => {
        el.style.opacity = '1';
        el.style.transform = 'none';
      });
    }
  });
  tl.to(spans, { opacity: 1, color: 'var(--text)', duration: 0.4, stagger: 0.03, ease: 'power2.out' })
    .to('.hero-meta', { opacity: 1, x: 0, duration: 0.4, stagger: 0.08, ease: 'power2.out' })
    .fromTo('#cover-img', { y: 60, opacity: 0, filter: 'blur(20px)' }, { y: 0, opacity: 1, filter: 'blur(0px)', duration: 1.2, ease: 'power3.out' })
    .from('#opportunity', { y: 60, opacity: 0, duration: 1, ease: 'power3.out' }, '-=0.5');

  gsap.utils.toArray<HTMLElement>('.section-block:not(#opportunity)').forEach((el) => {
    gsap.from(el, {
      y: 60,
      opacity: 0,
      duration: 1,
      ease: 'power3.out',
      scrollTrigger: {
        trigger: el,
        start: 'top 80%',
      },
    });
  });

  document.querySelectorAll<HTMLImageElement>('.section-block img:not(#persona-img-1):not(#persona-img-2)').forEach((img) => {
    img.style.opacity = '0';
    const show = () => gsap.to(img, { opacity: 1, duration: 1.2, ease: 'power3.out' });
    if (img.complete && img.naturalWidth > 0) show();
    else img.addEventListener('load', show, { once: true });
  });

  // Persona carousel
  const personas = [
    { el: document.getElementById('persona-img-0') as HTMLElement, label: 'Emily ⋅ Customer' },
    { el: document.getElementById('persona-img-1') as HTMLElement, label: 'Tony ⋅ Dealer' },
    { el: document.getElementById('persona-img-2') as HTMLElement, label: 'Nick ⋅ Converter' },
  ];
  const personaCaption = document.getElementById('persona-caption') as HTMLElement;
  let personaCurrent = 0;

  function goToPersona(next: number) {
    gsap.to(personas[personaCurrent].el, { opacity: 0, duration: 0.4, ease: 'power2.inOut' });
    gsap.to(personas[next].el, { opacity: 1, duration: 0.4, ease: 'power2.inOut' });
    gsap.to(personaCaption, { opacity: 0, duration: 0.2, onComplete: () => {
      personaCaption.textContent = personas[next].label;
      gsap.to(personaCaption, { opacity: 0.5, duration: 0.2 });
    }});
    personaCurrent = next;
  }


  document.getElementById('persona-prev')?.addEventListener('click', () => {
    goToPersona((personaCurrent - 1 + personas.length) % personas.length);
  });
  document.getElementById('persona-next')?.addEventListener('click', () => {
    goToPersona((personaCurrent + 1) % personas.length);
  });

  let personaInterval: ReturnType<typeof setInterval> | null = setInterval(() => {
    goToPersona((personaCurrent + 1) % personas.length);
  }, 8000);

  const pauseBtn = document.getElementById('persona-pause') as HTMLButtonElement;
  const pauseIcon = document.getElementById('persona-pause-icon') as HTMLElement;
  const playIcon = document.getElementById('persona-play-icon') as HTMLElement;

  pauseBtn.addEventListener('click', () => {
    if (personaInterval) {
      clearInterval(personaInterval);
      personaInterval = null;
      pauseIcon.classList.add('hidden');
      playIcon.classList.remove('hidden');
      pauseBtn.setAttribute('aria-label', 'Play autoplay');
    } else {
      personaInterval = setInterval(() => {
        goToPersona((personaCurrent + 1) % personas.length);
      }, 8000);
      pauseIcon.classList.remove('hidden');
      playIcon.classList.add('hidden');
      pauseBtn.setAttribute('aria-label', 'Pause autoplay');
    }
  });
</script>
